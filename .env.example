# ============================================================
# NurseAI — Environment Variables Template
# Copy this file to the appropriate location:
#   backend/.env   → all backend vars
#   frontend/.env.local → all NEXT_PUBLIC_ frontend vars
# Then fill in your actual values.
# ============================================================

# ── Backend (backend/.env) ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
# Project Settings -> API -> JWT Secret. Used to verify access tokens locally.
SUPABASE_JWT_SECRET=your_jwt_secret

# Shared by the rate limiter and role cache so limits/cache work correctly
# across more than one backend instance/worker. Leave unset for local dev
# (falls back to a per-process, single-instance-only cache) -- required
# before running more than one instance/worker in production.
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=

AI_PROVIDER=gemini
DEEPGRAM_API_KEY=your_deepgram_api_key

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx  # rzp_live_xxxxxxxxxxxxxxxx in production
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Auto-renew subscriptions -- run scripts/create_razorpay_plans.py once to
# create these in your Razorpay account, then paste the plan_xxx ids here.
RAZORPAY_PLAN_ID_BASIC=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_ELITE=

AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Error tracking. Leave blank to disable (main.py skips Sentry init entirely).
# Get a DSN from sentry.io -> Project Settings -> Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Frontend (frontend/.env.local) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

NEXTAUTH_SECRET=your_nextauth_secret_change_this
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx  # rzp_live_xxxxxxxxxxxxxxxx in production

NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

NEXT_PUBLIC_REALTIME_ROLLOUT_PCT=20  # % of users on the realtime speaking voice pipeline (0-100)

# ── Docker Compose ─────────────────────────────────────────
SECRET_KEY=your_super_secret_key_change_this_in_production
