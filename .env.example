# ============================================================
# NurseAI — Environment Variables Template
# Copy this file to the appropriate location:
#   backend/.env   → all backend vars
#   frontend/.env.local → all NEXT_PUBLIC_ frontend vars
# Then fill in your actual values.
# ============================================================

# ── Backend (backend/.env) ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
# Project Settings -> API -> JWT Secret. Used to verify access tokens locally.
SUPABASE_JWT_SECRET=your_jwt_secret

# Shared by the rate limiter and role cache so limits/cache work correctly
# across more than one backend instance/worker. Leave unset for local dev
# (falls back to a per-process, single-instance-only cache) -- required
# before running more than one instance/worker in production.
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=

AI_PROVIDER=gemini
DEEPGRAM_API_KEY=your_deepgram_api_key

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx  # rzp_live_xxxxxxxxxxxxxxxx in production
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Auto-renew subscriptions -- run scripts/create_razorpay_plans.py once to
# create these in your Razorpay account, then paste the plan_xxx ids here.
RAZORPAY_PLAN_ID_BASIC=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_ELITE=

AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# One PostHog project for every environment -- SENTRY_ENVIRONMENT below is
# reused as the "environment" property on every server-side event (see
# app/core/analytics.py), so this same key is correct in dev/rc1/production.
POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Error tracking. Leave blank to disable (main.py skips Sentry init entirely).
# Get a DSN from sentry.io -> Project Settings -> Client Keys (DSN).
SENTRY_DSN=
# development | rc1 | production -- one shared Sentry project, this tag is what
# separates them. Set to "development" to also skip Sentry init locally (see
# main.py); rc1/production deploys must set this explicitly.
SENTRY_ENVIRONMENT=development

# ── Frontend (frontend/.env.local) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Client-side error tracking (frontend/src/lib/sentry-client.ts). Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
# development | rc1 | production -- same purpose as backend SENTRY_ENVIRONMENT
# above, set per Vercel deployment target. Sentry init itself is skipped
# entirely outside production NODE_ENV builds (i.e. always skipped in local
# `next dev`), so this only needs to be set for rc1 vs production Vercel envs.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Sanity project powering blog.speakoet.com / docs.speakoet.com (frontend/src/lib/sanity.ts).
# Dataset defaults to "production" if unset.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Build-time only, used by next.config.js to upload Sentry source maps and
# tag releases. Leave unset to skip (build still succeeds, just no source
# maps / release tracking in Sentry).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXTAUTH_SECRET=your_nextauth_secret_change_this
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx  # rzp_live_xxxxxxxxxxxxxxxx in production

# One PostHog project for every environment -- NEXT_PUBLIC_SENTRY_ENVIRONMENT
# above is reused as the "environment" super-property (see src/lib/analytics.ts),
# so this same key is correct in dev/rc1/production.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics measurement ID (frontend/src/lib/ga.ts). Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel + Conversions API (frontend/src/lib/meta-pixel.ts + meta-capi.server.ts).
# Pixel ID is public (browser pixel + CAPI payload); access token is server-only,
# never prefix it with NEXT_PUBLIC_. Leave blank to disable.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=

NEXT_PUBLIC_REALTIME_ROLLOUT_PCT=20  # % of users on the realtime speaking voice pipeline (0-100)

# ── RC1 Playwright smoke tests (frontend/tests/e2e/, playwright.config.ts) ──
# Read from frontend/.env.local (playwright.config.ts loads it explicitly --
# `npx playwright test` doesn't go through Next's own env loading). login.spec.ts
# skips itself if the credentials are unset, so all four are optional.
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:8000
PLAYWRIGHT_TEST_USER_EMAIL=
PLAYWRIGHT_TEST_USER_PASSWORD=

# ── Docker Compose ─────────────────────────────────────────
SECRET_KEY=your_super_secret_key_change_this_in_production
